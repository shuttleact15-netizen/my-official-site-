---
const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Services', href: '#services' },
  { label: 'Works', href: '#works' },
  { label: 'Contact', href: '#contact' },
];
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Anjieeeeen - 福岡を拠点に活動する学生エンジニア・フリーランサー。Webサイト制作、Pythonによる自動化、ITサポートなどを行っています。"
    />
    <title>Anjieeeeen — Student Engineer / Freelancer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/script.js"></script>
  </head>
  <body>
    <div class="page-progress" id="pageProgress" aria-hidden="true"></div>
    <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

    <header class="header" id="header">
      <div class="header-inner">
        <a href="#top" class="logo">Anjieeeeen<span>.</span></a>

        <nav class="nav" id="nav">
          {navItems.map((item) => (
            <a href={item.href}>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
        </nav>

        <button
          class="menu-toggle"
          id="menuToggle"
          aria-label="メニューを開く"
          aria-expanded="false"
          aria-controls="nav"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main>
      <section class="hero" id="top">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

        <div class="hero-inner">
          <div class="hero-copy">
            <div class="hero-label">
              <span class="hero-label-line"></span>
              <span class="status-dot"></span>
              AVAILABLE FOR WORK
            </div>

            <h1>
              <span class="hero-kicker">Independent digital creator</span>
              Building things<br />
              <span>that work.</span>
            </h1>

            <div class="hero-bottom">
              <p class="hero-description">
                福岡を拠点に活動する学生エンジニア。<br />
                Web開発・業務自動化・ITサポートを中心に、
                アイデアを実際に動く形へ落とし込みます。
              </p>

              <div class="hero-actions">
                <a href="#works" class="text-link magnetic">
                  View selected works
                  <span>↗</span>
                </a>

                <a href="#contact" class="text-link text-link-secondary magnetic">
                  Contact / Inquiry
                  <span>↗</span>
                </a>
              </div>
            </div>
          </div>

          <aside class="hero-panel" aria-label="Selected work preview">
            <div class="hero-panel-top">
              <span>Selected work</span>
              <span>2026</span>
            </div>
            <div class="hero-panel-visual">
              <span class="panel-shape panel-shape-one"></span>
              <span class="panel-shape panel-shape-two"></span>
              <span class="panel-shape panel-shape-three"></span>
            </div>
            <div class="hero-panel-meta">
              <strong>Studio Portfolio</strong>
              <small>Brand identity / Web design</small>
            </div>
          </aside>
        </div>

        <div class="hero-line"></div>

        <div class="hero-meta">
          <span>FUKUOKA, JAPAN</span>
          <span>STUDENT ENGINEER / FREELANCER</span>
          <span>2026</span>
        </div>
      </section>

      <section id="about" class="section about">
        <div class="section-heading">
          <span class="section-number">01</span>
          <h1>About</h1>
        </div>

        <div class="about-grid">
          <div class="about-intro">
            <p class="large-text">
              技術を使って、<br />
              <em>面倒をシンプルに。</em>
            </p>

            <span class="about-accent-line"></span>

            <div class="about-description">
              <p>
                福岡でIT・情報系の専門技術を学んでいる学生エンジニアです。<br />
                学業と並行して、個人・法人向けのWeb制作や業務自動化などに取り組んでいます。
              </p>

              <p>
                「とりあえず作る」のではなく、目的や使う人を考えながら、<br />
                必要なものを必要なだけ作ることを大切にしています。
              </p>
            </div>

            <div class="about-scroll-cue">
              <span class="about-scroll-line"></span>
              <span>SCROLL TO NEXT</span>
              <span class="about-scroll-arrow">↓</span>
            </div>
          </div>

          <div class="about-content">
            <div class="about-info">
              <div class="info-row">
                <span>NAME</span>
                <strong>Anjieeeeen</strong>
              </div>

              <div class="info-row">
                <span>LOCATION</span>
                <strong>Fukuoka, Japan</strong>
              </div>

              <div class="info-row">
                <span>ROLE</span>
                <strong>Student Engineer / Freelancer</strong>
              </div>

              <div class="info-row">
                <span>FOCUS</span>
                <strong>Web / Python / Automation / Cloud</strong>
              </div>
            </div>

            <div class="about-channels" id="official-channels">
              <div class="about-channels-heading">
                <span>CONTACT / OFFICIAL CHANNELS</span>
                <p>お問い合わせ手段・宛先</p>
              </div>

              <div class="about-channel-list">
                <a href="#" class="about-channel is-preparing" aria-label="Google Form お問い合わせフォーム 準備中">
                  <span class="about-channel-icon about-channel-icon-form" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M7 3.5h7.5L19 8v12.5H7z" stroke="currentColor" stroke-width="1.6" />
                      <path d="M14 3.5V8h5M10 12h6M10 15h6M10 18h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                  </span>

                  <span class="about-channel-main">
                    <strong>Google Form</strong>
                    <small>お問い合わせフォーム</small>
                  </span>

                  <span class="about-channel-destination">お問い合わせフォームへのリンク</span>
                  <span class="about-channel-status">PREPARING</span>
                  <span class="about-channel-arrow">↗</span>
                </a>

                <a href="#" class="about-channel is-preparing" aria-label="X Twitter Anjieeeeen_dev 準備中">
                  <span class="about-channel-icon about-channel-icon-x" aria-hidden="true">X</span>

                  <span class="about-channel-main">
                    <strong>X (旧Twitter)</strong>
                    <small>SNS / 活動情報</small>
                  </span>

                  <span class="about-channel-destination">@Anjieeeeen_dev</span>
                  <span class="about-channel-status">PREPARING</span>
                  <span class="about-channel-arrow">↗</span>
                </a>

                <a href="#" class="about-channel is-preparing" aria-label="GitHub Anjieeeeen 準備中">
                  <span class="about-channel-icon about-channel-icon-github" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.5a9.5 9.5 0 0 0-3 18.51c.47.09.65-.2.65-.45v-1.63c-2.65.58-3.21-1.13-3.21-1.13-.43-1.1-1.05-1.39-1.05-1.39-.86-.59.06-.58.06-.58.95.07 1.45.98 1.45.98.85 1.45 2.22 1.03 2.76.79.09-.61.33-1.03.6-1.27-2.12-.24-4.35-1.06-4.35-4.72 0-1.04.37-1.89.98-2.56-.1-.24-.43-1.21.09-2.53 0 0 .8-.26 2.62.98a9.12 9.12 0 0 1 4.77 0c1.82-1.24 2.62-.98 2.62-.98.52 1.32.19 2.29.09 2.53.61.67.98 1.52.98 2.56 0 3.67-2.24 4.48-4.37 4.71.34.3.64.87.64 1.76v2.61c0 .25.17.55.65.45A9.5 9.5 0 0 0 12 2.5Z"/>
                    </svg>
                  </span>

                  <span class="about-channel-main">
                    <strong>GitHub</strong>
                    <small>Projects / Code</small>
                  </span>

                  <span class="about-channel-destination">github.com/Anjieeeeen</span>
                  <span class="about-channel-status">PREPARING</span>
                  <span class="about-channel-arrow">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="skills" class="section skills">
        <div class="section-heading">
          <span class="section-number">02</span>
          <h1>Skills</h1>
        </div>

        <div class="skills-intro">
          <p>
            Web開発からPython、自動化、クラウドまで。
            現在の開発環境と、実際に使用している技術です。
          </p>
        </div>

        <div class="skills-list">
          <div class="skill-group">
            <div class="skill-index">01</div>
            <div>
              <h3>Frontend</h3>
              <div class="skill-tags">
                <span>HTML5</span>
                <span>CSS3</span>
                <span>JavaScript</span>
              </div>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-index">02</div>
            <div>
              <h3>Development</h3>
              <div class="skill-tags">
                <span>Python</span>
                <span>Flutter</span>
                <span>Git</span>
                <span>GitHub</span>
              </div>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-index">03</div>
            <div>
              <h3>Environment</h3>
              <div class="skill-tags">
                <span>VS Code</span>
                <span>Cursor</span>
                <span>Linux</span>
                <span>Windows</span>
                <span>macOS</span>
              </div>
            </div>
          </div>

          <div class="skill-group">
            <div class="skill-index">04</div>
            <div>
              <h3>Cloud &amp; AI</h3>
              <div class="skill-tags">
                <span>AWS</span>
                <span>ChatGPT</span>
                <span>GitHub Copilot</span>
              </div>
            </div>
          </div>
        </div>

        <div class="certifications">
          <span class="cert-label">CERTIFICATIONS</span>
          <div class="cert-list">
            <span>基本情報技術者試験</span>
            <span>ITパスポート</span>
            <span>AWS Certified Cloud Practitioner</span>
          </div>
        </div>
      </section>

      <section id="services" class="section services">
        <div class="section-heading">
          <span class="section-number">03</span>
          <h1>Services</h1>
        </div>

        <div class="services-intro">
          <span>WHAT I CAN BUILD</span>
          <p>目的に合わせて、見た目だけではなく「使いやすさ」まで設計します。</p>
        </div>

        <div class="services-list">
          <article class="service">
            <div class="service-top">
              <span class="service-number">01</span>
              <span class="service-arrow">↗</span>
            </div>
            <div class="service-body">
              <h3>Web Development</h3>
              <p>
                LPやコーポレートサイトなど、
                HTML / CSS / JavaScriptを使ったWebサイトを制作します。
              </p>
              <div class="service-tags">
                <span>LP</span>
                <span>Responsive</span>
                <span>HTML / CSS</span>
              </div>
            </div>
          </article>

          <article class="service">
            <div class="service-top">
              <span class="service-number">02</span>
              <span class="service-arrow">↗</span>
            </div>
            <div class="service-body">
              <h3>Automation</h3>
              <p>
                Pythonを使ったデータ収集や、
                Excel・スプレッドシートなどの定型業務を自動化します。
              </p>
              <div class="service-tags">
                <span>Python</span>
                <span>Scraping</span>
                <span>Automation</span>
              </div>
            </div>
          </article>

          <article class="service">
            <div class="service-top">
              <span class="service-number">03</span>
              <span class="service-arrow">↗</span>
            </div>
            <div class="service-body">
              <h3>IT Support</h3>
              <p>
                PC環境や開発環境の構築、
                AWSなどクラウドに関する基礎的なサポートを行います。
              </p>
              <div class="service-tags">
                <span>Setup</span>
                <span>Cloud</span>
                <span>Environment</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="section process" id="process">
        <div class="section-heading">
          <span class="section-number">04</span>
          <h2>Process</h2>
        </div>

        <div class="process-intro">
          <p>相談から公開まで、必要な工程をシンプルに。</p>
        </div>

        <div class="process-list">
          <article class="process-step">
            <span>01</span>
            <div>
              <h3>Discover</h3>
              <p>目的・課題・必要な機能を整理します。</p>
            </div>
          </article>

          <article class="process-step">
            <span>02</span>
            <div>
              <h3>Design</h3>
              <p>情報設計とUIを考え、使いやすい形に落とし込みます。</p>
            </div>
          </article>

          <article class="process-step">
            <span>03</span>
            <div>
              <h3>Build</h3>
              <p>実装・動作確認・レスポンシブ対応まで進めます。</p>
            </div>
          </article>

          <article class="process-step">
            <span>04</span>
            <div>
              <h3>Refine</h3>
              <p>公開前に細部を整え、完成度を高めます。</p>
            </div>
          </article>
        </div>
      </section>

      <section id="works" class="section works">
        <div class="section-heading">
          <span class="section-number">05</span>
          <h1>Selected Works</h1>
        </div>

        <div class="works-header">
          <p>
            制作したWebサイトや個人開発プロジェクトを
            順次掲載していきます。
          </p>
          <span class="works-count">02 PROJECTS</span>
        </div>

        <div class="works-list">
          <article class="work">
            <div class="work-visual">
              <div class="visual-placeholder">
                <span>PROJECT 01</span>
              </div>
            </div>

            <div class="work-info">
              <div class="work-meta">
                <span>01 / WEB</span>
                <span>2026</span>
              </div>

              <h3>Landing Page</h3>
              <p>レスポンシブ対応を想定したサンプルランディングページ。</p>
              <span class="work-status">COMING SOON</span>
            </div>
          </article>

          <article class="work">
            <div class="work-visual">
              <div class="visual-placeholder">
                <span>PROJECT 02</span>
              </div>
            </div>

            <div class="work-info">
              <div class="work-meta">
                <span>02 / PYTHON</span>
                <span>2026</span>
              </div>

              <h3>Automation Tool</h3>
              <p>Pythonを利用した個人開発の業務効率化ツール。</p>
              <span class="work-status">COMING SOON</span>
            </div>
          </article>
        </div>
      </section>

      <section id="contact" class="contact">
        <div class="contact-inner">
          <span class="contact-label">06 / CONTACT</span>

          <h2>
            Have a project<br />
            <em>in mind?</em>
          </h2>

          <p>
            Web制作、業務自動化、その他ITに関するご相談など、
            まずはお気軽にお問い合わせください。
          </p>

          <a href="#about" class="contact-button">
            <span>Get in touch</span>
            <span>↗</span>
          </a>

          <div class="contact-links">
            <span class="contact-links-label">ELSEWHERE</span>
            <a href="#about">About / Official channels</a>
          </div>
        </div>
      </section>
    </main>

    <a href="#top" class="back-to-top" aria-label="ページ上部へ戻る">↑</a>

    <footer class="footer">
      <div class="footer-inner">
        <span>© 2026 Anjieeeeen.</span>
        <span>Fukuoka, Japan</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #efece7;
    --surface: rgba(255,255,255,0.38);
    --surface-strong: rgba(255,255,255,0.7);
    --surface-2: #e8e4de;
    --text: #111827;
    --muted: #5f6770;
    --line: rgba(17,24,39,0.12);
    --dark: #111827;
    --accent: #5d6d7c;
    --radius-control: 4px;
    --radius-panel: 6px;
    --max-width: 1240px;
    --ease: cubic-bezier(.2,.7,.2,1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
  }

  body {
    font-family: "Inter", "Noto Sans JP", sans-serif;
    color: var(--text);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.04)),
      url('/bg.jpg') center top / cover no-repeat fixed;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    position: relative;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: rgba(240,236,231,0.08);
    pointer-events: none;
    z-index: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  ::selection {
    background: #111;
    color: #fff;
  }

  .page-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: #111;
    z-index: 2000;
  }

  .cursor-glow {
    position: fixed;
    width: 260px;
    height: 260px;
    left: 0;
    top: 0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(0,0,0,.055), transparent 68%);
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: .35s ease;
  }

  .header.scrolled {
    background: rgba(247,245,241,0.56);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(17,24,39,0.09);
  }

  .header-inner {
    width: min(calc(100% - 64px), var(--max-width));
    height: 84px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(17,24,39,0.12);
  }

  .logo {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -.05em;
    transition: transform .3s var(--ease);
  }

  .logo:hover {
    transform: translateY(-2px);
  }

  .logo span {
    color: #888;
  }

  .nav {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0;
    padding: 8px 18px 8px 22px;
  }

  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%, 11px 50%);
    background: rgba(17,24,39,.28);
    filter: drop-shadow(0 4px 7px rgba(17,24,39,.09));
    pointer-events: none;
  }

  .nav::after {
    content: "";
    position: absolute;
    inset: 1px;
    z-index: 0;
    clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 50%, calc(100% - 13px) 100%, 0 100%, 10px 50%);
    background:
      linear-gradient(90deg, transparent, rgba(93,109,124,.38), transparent) center bottom / 58% 1px no-repeat,
      linear-gradient(180deg, rgba(255,255,255,.82), rgba(239,237,232,.76));
    pointer-events: none;
  }

  .nav a {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 13px;
    border-radius: 3px;
    color: rgba(17, 24, 39, 0.78);
    transition: color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .nav a:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 22%;
    left: 0;
    width: 2px;
    height: 56%;
    background: linear-gradient(180deg, transparent, rgba(93,109,124,.38), transparent);
    pointer-events: none;
  }

  .nav-label {
    position: relative;
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .01em;
    transition: transform .28s var(--ease), letter-spacing .28s var(--ease), color .2s ease;
  }

  .nav-label::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -6px;
    left: 0;
    height: 1px;
    background: var(--accent);
    opacity: 0;
    transform: scaleX(.25);
    transform-origin: left;
    transition: transform .28s var(--ease), opacity .2s ease;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--dark);
    background: rgba(255,255,255,.72);
    box-shadow: 0 1px 4px rgba(17,24,39,.055), inset 0 0 0 1px rgba(17,24,39,.035);
  }

  .nav a:hover .nav-label,
  .nav a:focus-visible .nav-label {
    transform: translateY(-2px);
    letter-spacing: .025em;
  }

  .nav a:hover .nav-label::after,
  .nav a:focus-visible .nav-label::after {
    opacity: .72;
    transform: scaleX(1);
  }

  .nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 6px auto;
    background: #111;
    transition: transform .25s;
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
