  .visual-placeholder {
    width: 100%;
    height: 100%;
    min-height: 410px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(to right, rgba(17,24,39,.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(17,24,39,.035) 1px, transparent 1px),
      linear-gradient(135deg, #e7e5df, #f3f1ec 54%, #dfdfda);
    background-size: 32px 32px, 32px 32px, auto;
    color: #9a9a94;
    transition: background-color .35s ease;
  }

  .visual-placeholder::before,
  .visual-placeholder::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .visual-placeholder::before {
    width: min(76%, 560px);
    height: 68%;
    border: 1px solid rgba(17,24,39,.13);
    border-radius: 3px;
    background:
      linear-gradient(rgba(17,24,39,.12),rgba(17,24,39,.12)) 18px 16px / 31% 4px no-repeat,
      linear-gradient(rgba(17,24,39,.08),rgba(17,24,39,.08)) right 18px top 16px / 22% 4px no-repeat,
      linear-gradient(rgba(17,24,39,.2),rgba(17,24,39,.2)) 18px 48px / 42% 9px no-repeat,
      linear-gradient(rgba(17,24,39,.09),rgba(17,24,39,.09)) 18px 68px / 34% 4px no-repeat,
      linear-gradient(rgba(17,24,39,.07),rgba(17,24,39,.07)) 18px 78px / 27% 4px no-repeat,
      linear-gradient(135deg, rgba(93,109,124,.2), rgba(93,109,124,.06)) right 18px top 42px / 32% calc(100% - 58px) no-repeat,
      rgba(255,255,255,.72);
    box-shadow: 0 14px 35px rgba(17,24,39,.07);
  }

  .visual-placeholder::after {
    right: 15%;
    bottom: 14%;
    width: 20%;
    height: 12%;
    border: 1px solid rgba(17,24,39,.12);
    border-radius: 2px;
    background: rgba(247,246,242,.92);
    box-shadow: 0 8px 18px rgba(17,24,39,.07);
  }

  .work:hover .visual-placeholder {
    background-color: rgba(255,255,255,.22);
